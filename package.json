{
	"name": "astro-coming-soon-template",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "pnpm build:astro && pnpm content:index",
		"build:astro": "astro check && astro build",
		"content:index": "pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"typecheck": "astro check",
		"check": "pnpm format && pnpm lint && pnpm typecheck",
		"fix": "pnpm format:fix && pnpm lint:fix",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/react": "^6.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.6",
		"astro-robots-txt": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.28.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"pagefind": "^1.5.2",
		"sharp": "^0.35.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.0"
	},
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=11.11.0"
	},
	"packageManager": "pnpm@11.18.0"
}
