---
import { Image } from "astro:assets";

import { formatPostDate, getPostPath, getReadingTime, getTagPath, slugifyTag, type BlogEntry } from "../lib/content";

interface Props {
	post: BlogEntry;
	index: number;
}

const { post, index } = Astro.props;
const href = getPostPath(post);
const readingTime = getReadingTime(post);
---

<article class="group border-border bg-card text-card-foreground grid overflow-hidden rounded-xl border shadow-sm transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-foreground/25 hover:shadow-lg">
	{
		post.data.cover && (
			<a href={href} class="bg-muted border-border block overflow-hidden border-b" tabindex="-1" aria-hidden="true">
				<Image
					src={post.data.cover}
					alt={post.data.coverAlt ?? ""}
					widths={[480, 768, 960]}
					sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
					class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
				/>
			</a>
		)
	}
	<div class="flex min-h-72 flex-col p-5 sm:p-6">
		<div class="text-muted-foreground mb-8 flex items-center justify-between gap-4 text-xs font-medium tracking-wide uppercase">
			<span aria-hidden="true">{String(index).padStart(2, "0")}</span>
			<span>{readingTime} min read</span>
		</div>
		<h2 class="text-foreground text-xl leading-tight font-bold tracking-[-0.025em] text-balance sm:text-2xl">
			<a href={href} class="focus-visible:ring-ring rounded-sm outline-none focus-visible:ring-2">{post.data.title}</a>
		</h2>
		<p class="text-muted-foreground mt-4 line-clamp-3 text-sm leading-6">{post.data.description}</p>
		<div class="border-border mt-auto flex flex-wrap items-end justify-between gap-4 border-t pt-5">
			<time datetime={post.data.publishedAt.toISOString()} class="text-muted-foreground text-xs">
				{formatPostDate(post.data.publishedAt)}
			</time>
			{
				post.data.tags.length > 0 && (
					<div class="relative flex flex-wrap justify-end gap-2">
						{post.data.tags.map((tag) => (
							<a
								href={getTagPath(slugifyTag(tag))}
								class="bg-muted text-muted-foreground focus-visible:ring-ring rounded-full px-2.5 py-1 text-[0.7rem] font-medium transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:outline-none"
							>
								{tag}
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</article>
