---
import { getAssetPath } from "@/lib/utils";

import { getSearchPath } from "../lib/content";

const pagefindUrl = getAssetPath("pagefind/pagefind.js");
const pagefindBaseUrl = getAssetPath("");
const pagefindBasePath = getAssetPath("pagefind/");
---

<section
	data-content-search
	data-pagefind-url={pagefindUrl}
	data-pagefind-base-url={pagefindBaseUrl}
	data-pagefind-base-path={pagefindBasePath}
	data-development={String(import.meta.env.DEV)}
	class="mx-auto w-full max-w-4xl"
>
	<form
		action={getSearchPath()}
		method="get"
		role="search"
		class="flex gap-2 rounded-xl border border-border bg-card p-2 shadow-sm"
	>
		<label for="content-search-input" class="sr-only">
			Search articles
		</label>
		<svg
			class="ml-3 size-5 shrink-0 self-center text-muted-foreground"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			aria-hidden="true"
		>
			<circle cx="11" cy="11" r="7" />
			<path d="m20 20-4-4" />
		</svg>
		<input
			id="content-search-input"
			name="q"
			type="search"
			autocomplete="off"
			placeholder="Search titles and article text…"
			class="min-h-11 min-w-0 flex-1 bg-transparent px-2 text-base text-foreground outline-none placeholder:text-muted-foreground"
		/>
		<button
			type="submit"
			class="min-h-11 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-85 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
		>
			Search
		</button>
	</form>

	<p data-search-status role="status" aria-live="polite" class="min-h-14 px-1 py-5 text-sm text-muted-foreground">
		Type a word or phrase to search the journal.
	</p>
	<ol data-search-results class="grid gap-3"></ol>
	<button
		type="button"
		data-search-more
		hidden
		class="mt-5 min-h-11 rounded-lg border border-border px-5 text-sm font-semibold"
	>
		Load more results
	</button>
	<button
		type="button"
		data-search-retry
		hidden
		class="mt-5 min-h-11 rounded-lg border border-border px-5 text-sm font-semibold"
	>
		Retry search
	</button>
	<template data-search-result-template>
		<li class="rounded-xl border border-border bg-card p-5 transition-colors hover:border-foreground/25 sm:p-6">
			<a data-result-link class="group block rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring">
				<h2
					data-result-title
					class="text-lg font-bold tracking-tight text-foreground group-hover:underline sm:text-xl"
				></h2>
				<p data-result-excerpt class="mt-2 text-sm leading-6 text-muted-foreground"></p>
				<span class="mt-4 inline-flex items-center gap-2 text-xs font-medium tracking-wide text-muted-foreground uppercase">
					Read article <span aria-hidden="true">→</span>
				</span>
			</a>
		</li>
	</template>
</section>

<script is:inline>
	const updateSearchUrl = (query) => {
		const url = new URL(window.location.href);
		if (query) url.searchParams.set("q", query);
		else url.searchParams.delete("q");
		window.history.replaceState(window.history.state, "", url);
	};

	for (const root of document.querySelectorAll("[data-content-search]")) {
		const form = root.querySelector("form");
		const input = root.querySelector('input[type="search"]');
		const status = root.querySelector("[data-search-status]");
		const results = root.querySelector("[data-search-results]");
		const template = root.querySelector("[data-search-result-template]");
		const more = root.querySelector("[data-search-more]"),
			retry = root.querySelector("[data-search-retry]");

		if (!form || !input || !status || !results || !template || !more || !retry) continue;

		let pagefindPromise;
		let debounceTimer;
		let requestId = 0,
			loadAttempt = 0,
			shown = 0;
		let handles = [],
			activeQuery = "",
			detailBusy = false;

		const loadPagefind = () => {
			if (!pagefindPromise) {
				pagefindPromise = (async () => {
					const pagefindUrl = root.dataset.pagefindUrl;
					const baseUrl = root.dataset.pagefindBaseUrl;
					const basePath = root.dataset.pagefindBasePath;
					if (!pagefindUrl || !baseUrl || !basePath) throw new Error("Pagefind paths are not configured.");
					const moduleUrl = new URL(pagefindUrl, window.location.href);
					if (loadAttempt) moduleUrl.searchParams.set("retry", String(loadAttempt));
					const pagefind = await import(moduleUrl.href);
					await pagefind.options({ baseUrl, basePath });
					await pagefind.init();
					return pagefind;
				})().catch((error) => {
					pagefindPromise = undefined;
					loadAttempt++;
					throw error;
				});
			}

			return pagefindPromise;
		};

		const showResults = (items, append = false) => {
			if (!append) results.replaceChildren();
			for (const item of items) {
				const fragment = template.content.cloneNode(true);
				const link = fragment.querySelector("[data-result-link]");
				const title = fragment.querySelector("[data-result-title]");
				const excerpt = fragment.querySelector("[data-result-excerpt]");
				if (!link || !title || !excerpt) continue;
				link.href = item.url;
				title.textContent = item.meta.title ?? "Untitled article";
				excerpt.textContent = item.plain_excerpt;
				results.append(fragment);
			}
		};

		const showBatch = async (activeRequest, append = false) => {
			if (activeRequest !== requestId || detailBusy) return;
			detailBusy = true;
			more.disabled = true;
			try {
				const items = await Promise.all(handles.slice(shown, shown + 20).map((result) => result.data()));
				if (activeRequest !== requestId) return;
				showResults(items, append);
				shown += items.length;
				more.hidden = shown >= handles.length;
				status.textContent = handles.length
					? `Showing ${shown} of ${handles.length} articles for “${activeQuery}”.`
					: `No articles found for “${activeQuery}”.`;
			} finally {
				if (activeRequest === requestId) {
					detailBusy = false;
					more.disabled = false;
				}
			}
		};

		const search = async (value) => {
			const query = value.trim();
			const activeRequest = ++requestId;
			activeQuery = query;
			handles = [];
			shown = 0;
			detailBusy = false;
			more.hidden = true;
			retry.hidden = true;
			updateSearchUrl(query);

			if (!query) {
				results.replaceChildren();
				status.textContent = "Type a word or phrase to search the journal.";
				return;
			}

			status.textContent = `Searching for “${query}”…`;

			try {
				const pagefind = await loadPagefind();
				if (activeRequest !== requestId) return;
				const response = await pagefind.search(query);
				if (activeRequest !== requestId) return;
				handles = response.results;
				await showBatch(activeRequest);
			} catch {
				if (activeRequest !== requestId) return;
				results.replaceChildren();
				retry.hidden = false;
				status.textContent =
					root.dataset.development === "true"
						? "The search index is created by pnpm build. Run pnpm build, then pnpm preview to test search."
						: "Search could not load. Check your connection, then use Retry search.";
			}
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			window.clearTimeout(debounceTimer);
			void search(input.value);
		});

		input.addEventListener("focus", () => void loadPagefind().catch(() => undefined), { once: true });
		input.addEventListener("input", () => {
			window.clearTimeout(debounceTimer);
			requestId++;
			detailBusy = false;
			more.hidden = true;
			retry.hidden = true;
			debounceTimer = window.setTimeout(() => void search(input.value), 180);
		});

		more.addEventListener("click", () => {
			const activeRequest = requestId;
			void showBatch(activeRequest, true).catch(() => {
				if (activeRequest !== requestId) return;
				status.textContent = "More results could not load. Use Load more results to retry.";
			});
		});
		retry.addEventListener("click", () => {
			void search(input.value);
		});

		const initialQuery = new URL(window.location.href).searchParams.get("q") ?? "";
		if (initialQuery) {
			input.value = initialQuery;
			void search(initialQuery);
		}
	}
</script>
