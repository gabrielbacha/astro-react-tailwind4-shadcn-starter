---
import PostCard from "./PostCard.astro";
import type { BlogEntry } from "../lib/content";

interface Props {
	posts: BlogEntry[];
	startIndex?: number;
	emptyMessage?: string;
}

const { posts, startIndex = 0, emptyMessage = "No published posts yet." } = Astro.props;
---

{
	posts.length > 0 ? (
		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post, index) => <PostCard post={post} index={startIndex + index + 1} />)}
		</div>
	) : (
		<div class="border-border bg-muted/35 rounded-xl border border-dashed px-6 py-16 text-center">
			<p class="text-muted-foreground text-sm">{emptyMessage}</p>
		</div>
	)
}
