---
import Layout from "@/layouts/Layout.astro";
import type { SeoData } from "@/types/seo";

import ContentHeader from "../components/ContentHeader.astro";
import SearchForm from "../components/SearchForm.astro";
import { contentSiteConfig } from "../config";
import { getBlogPath, getFeedPath, getSearchPath } from "../lib/content";

const seo = {
	title: `Search | ${contentSiteConfig.feedTitle}`,
	description: "Search published journal entries by title and article text.",
	canonicalPath: getSearchPath(),
	feed: { href: getFeedPath(), title: contentSiteConfig.feedTitle },
	noindex: true,
} satisfies SeoData;
---

<Layout seo={seo}>
	<ContentHeader eyebrow="Index / Search" title="Search the archive." description="A local, privacy-friendly index generated from the published static pages.">
		<a slot="actions" href={getBlogPath()} class="border-border bg-background text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center rounded-md border px-4 text-sm font-medium transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:outline-none">
			All posts
		</a>
	</ContentHeader>
	<div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		<SearchForm />
	</div>
</Layout>
