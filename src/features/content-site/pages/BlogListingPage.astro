---
import Layout from "@/layouts/Layout.astro";
import type { SeoData } from "@/types/seo";

import ContentHeader from "../components/ContentHeader.astro";
import Pagination from "../components/Pagination.astro";
import PostGrid from "../components/PostGrid.astro";
import { contentSiteConfig } from "../config";
import { getBlogPath, getFeedPath, getSearchPath, getTagsPath, type BlogEntry } from "../lib/content";

interface Props {
	posts: BlogEntry[];
	currentPage: number;
	lastPage: number;
	totalPosts: number;
}

const { posts, currentPage, lastPage, totalPosts } = Astro.props;
const isFirstPage = currentPage === 1;
const title = isFirstPage ? contentSiteConfig.feedTitle : `${contentSiteConfig.feedTitle} — Page ${currentPage}`;
const seo = {
	title,
	description: contentSiteConfig.feedDescription,
	canonicalPath: getBlogPath(currentPage),
	feed: { href: getFeedPath(), title: contentSiteConfig.feedTitle },
} satisfies SeoData;
const startIndex = (currentPage - 1) * contentSiteConfig.pageSize;
---

<Layout seo={seo}>
	<ContentHeader
		eyebrow={`Journal / ${String(currentPage).padStart(2, "0")}`}
		title="Notes built to last."
		description={contentSiteConfig.feedDescription}
	>
		<a
			slot="actions"
			href={getSearchPath()}
			class="inline-flex min-h-11 items-center rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
		>
			Search
		</a>
		<a
			slot="actions"
			href={getFeedPath()}
			class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-85 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
		>
			RSS feed
		</a>
	</ContentHeader>

	<section class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase">Archive</p>
				<h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground">
					{totalPosts} published {totalPosts === 1 ? "entry" : "entries"}
				</h2>
			</div>
			<a
				href={getTagsPath()}
				class="rounded-sm text-sm font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
			>
				Browse by tag <span aria-hidden="true">→</span>
			</a>
		</div>
		<PostGrid posts={posts} startIndex={startIndex} />
		<Pagination currentPage={currentPage} lastPage={lastPage} />
	</section>
</Layout>
