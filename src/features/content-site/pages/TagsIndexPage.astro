---
import Layout from "@/layouts/Layout.astro";
import type { SeoData } from "@/types/seo";

import ContentHeader from "../components/ContentHeader.astro";
import { contentSiteConfig } from "../config";
import { getBlogPath, getFeedPath, getTagGroups, getTagPath, getTagsPath } from "../lib/content";

const groups = await getTagGroups();
const seo = {
	title: `Tags | ${contentSiteConfig.feedTitle}`,
	description: "Browse published journal entries by topic.",
	canonicalPath: getTagsPath(),
	feed: { href: getFeedPath(), title: contentSiteConfig.feedTitle },
} satisfies SeoData;
---

<Layout seo={seo}>
	<ContentHeader
		eyebrow="Index / Tags"
		title="Find the thread."
		description="Every topic in the journal, organized as a compact index rather than another feed."
	>
		<a
			slot="actions"
			href={getBlogPath()}
			class="inline-flex min-h-11 items-center rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
		>
			All posts
		</a>
	</ContentHeader>
	<section class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		{groups.length > 0 ? (
			<ul class="grid overflow-hidden rounded-xl border border-border sm:grid-cols-2 lg:grid-cols-3">
				{groups.map((group, index) => (
					<li class="-mt-px -ml-px border-t border-l border-border first:mt-0 first:ml-0">
						<a
							href={getTagPath(group.slug)}
							class="group flex min-h-36 items-end justify-between gap-6 p-5 transition-colors outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring sm:p-6"
						>
							<div>
								<p class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
									{String(index + 1).padStart(2, "0")}
								</p>
								<h2 class="mt-4 text-xl font-bold tracking-tight text-foreground group-hover:underline">
									{group.name}
								</h2>
							</div>
							<span class="text-sm text-muted-foreground">{group.posts.length}</span>
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="rounded-xl border border-dashed border-border px-6 py-16 text-center text-sm text-muted-foreground">
				No tags are available yet.
			</p>
		)}
	</section>
</Layout>
