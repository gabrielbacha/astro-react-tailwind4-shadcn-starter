---
import Layout from "@/layouts/Layout.astro";
import type { SeoData } from "@/types/seo";

import ContentHeader from "../components/ContentHeader.astro";
import { contentSiteConfig } from "../config";
import { getBlogPath, getFeedPath, getTagGroups, getTagPath, getTagsPath } from "../lib/content";

const groups = await getTagGroups();
const seo = {
	title: `Tags | ${contentSiteConfig.feedTitle}`,
	description: "Browse published journal entries by topic.",
	canonicalPath: getTagsPath(),
	feed: { href: getFeedPath(), title: contentSiteConfig.feedTitle },
} satisfies SeoData;
---

<Layout seo={seo}>
	<ContentHeader eyebrow="Index / Tags" title="Find the thread." description="Every topic in the journal, organized as a compact index rather than another feed.">
		<a slot="actions" href={getBlogPath()} class="border-border bg-background text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center rounded-md border px-4 text-sm font-medium transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:outline-none">
			All posts
		</a>
	</ContentHeader>
	<section class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		{
			groups.length > 0 ? (
				<ul class="border-border grid overflow-hidden rounded-xl border sm:grid-cols-2 lg:grid-cols-3">
					{groups.map((group, index) => (
						<li class="border-border -mt-px -ml-px border-t border-l first:mt-0 first:ml-0">
							<a href={getTagPath(group.slug)} class="focus-visible:ring-ring group flex min-h-36 items-end justify-between gap-6 p-5 outline-none transition-colors hover:bg-accent focus-visible:ring-2 sm:p-6">
								<div>
									<p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">{String(index + 1).padStart(2, "0")}</p>
									<h2 class="text-foreground mt-4 text-xl font-bold tracking-tight group-hover:underline">{group.name}</h2>
								</div>
								<span class="text-muted-foreground text-sm">{group.posts.length}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="border-border text-muted-foreground rounded-xl border border-dashed px-6 py-16 text-center text-sm">No tags are available yet.</p>
			)
		}
	</section>
</Layout>
