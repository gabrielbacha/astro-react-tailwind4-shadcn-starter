---
// Load the UI/wordmark font via Fontsource (self-hosted, open-source).
// Keep the stylesheet and preload URL in sync when changing the typeface.
import "@fontsource-variable/jetbrains-mono";
import fontUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
---

<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
