{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": false,
	"trailingComma": "all",
	"printWidth": 120,
	"bracketSameLine": false,
	"ignorePatterns": [
		".astro/**",
		".zcode/**",
		"dist/**",
		"out/**",
		"build/**",
		"coverage/**",
		"astroplate/**",
		"node_modules/**",
		"pnpm-lock.yaml",
		"**/*.tsbuildinfo",
		"test-results/**",
		"playwright-report/**"
	],
	"sortImports": {
		"internalPattern": ["@/"],
		"groups": [["builtin", "external"], "internal", ["parent", "sibling", "index"], "type", "unknown"]
	},
	"sortTailwindcss": {
		"functions": ["cn", "cva"],
		"stylesheet": "./src/styles/global.css"
	},
	"astro": true,
	"overrides": [
		{
			"files": ["*.astro"],
			"options": {
				"sortImports": false
			}
		}
	]
}
